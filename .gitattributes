# Bundled templates, scripts and sources are hashed, embedded and run as
# written: keep LF line endings in every checkout, Windows included.
* text=auto eol=lf
# Unified diffs require a leading context space before upstream tabs/blank lines.
tools/busybox-w32-patches/*.patch whitespace=-space-before-tab,-blank-at-eol

# Qualification logs preserve exact emitted bytes for recorded SHA-256 digests.
reports/*.log whitespace=-blank-at-eol,-blank-at-eof

# Preserve original Windows qualification receipt bytes and their recorded hashes.
docs/qa/windows-candidate-bf62e84/*.json -text whitespace=cr-at-eol
docs/qa/onboarding-navigation-2.4.1/*.txt whitespace=-blank-at-eof

# Original v2.4.1 qualification evidence: preserve receipt bytes and hashes.
docs/qa/windows-candidate-a3b09ec/** -text whitespace=cr-at-eol,-blank-at-eof
docs/qa/platform-release-2.4.1/** -text whitespace=cr-at-eol,-blank-at-eof
docs/qa/source-ci-2.4.1/** -text whitespace=cr-at-eol,-blank-at-eof
# Model-generated fixture is evidence; retain its original whitespace and hash.
docs/qa/platform-release-2.4.1/windows-model-fixture/helpers.py whitespace=-blank-at-eol
