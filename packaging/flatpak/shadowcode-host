#!/bin/bash
# Forward only the environment selected by the native runner. Flatpak-specific
# loader/profile variables must not alter the host tool's loader or sign-in.
set -euo pipefail
[[ $# -gt 0 ]] || { echo 'Choose a host command' >&2; exit 64; }
program=$1
shift
arguments=(--host --forward-fd=3 --clear-env --directory="$PWD")
while IFS= read -r -d '' entry; do
  name=${entry%%=*}
  case "$name" in
    LD_*|FLATPAK_*|GTK_*|GDK_*|GIO_*|GI_TYPELIB_PATH|GST_*|XDG_CONFIG_HOME|XDG_DATA_HOME|XDG_STATE_HOME|XDG_CACHE_HOME|XDG_RUNTIME_DIR|PATH|DBUS_SESSION_BUS_ADDRESS|SHADOWCODE_HOST_PATH|SHADOWCODE_HOST_DBUS) ;;
    *) arguments+=("--env=$entry") ;;
  esac
done < <(/usr/bin/env -0)
arguments+=("--env=PATH=${SHADOWCODE_HOST_PATH:-/usr/local/bin:/usr/bin:/bin}")
arguments+=("--env=DBUS_SESSION_BUS_ADDRESS=${SHADOWCODE_HOST_DBUS:-unix:path=/run/user/$(id -u)/bus}")
# Forward a read-only FIFO descriptor; retain its separate writer only in
# this process. The host helper sees EOF when the bridge is killed. Unlike
# --watch-bus, it owns and stops the entire command tree, not just its leader.
temporary=$(mktemp -d "${TMPDIR:-/tmp}/shadowcode-host.XXXXXX")
mkfifo "$temporary/live"
exec 4<>"$temporary/live"
exec 3<"$temporary/live"
exec 5>"$temporary/live"
exec 4>&-
rm "$temporary/live"
rmdir "$temporary"
app_path=$(sed -n 's/^app-path=//p' /.flatpak-info)
monitor="$app_path/libexec/shadowcode-host-monitor"
[[ -n "$app_path" ]] || { echo 'ShadowCode host bridge requires an installed application' >&2; exit 1; }
exec /usr/bin/flatpak-spawn "${arguments[@]}" "$monitor" "$program" "$@"
